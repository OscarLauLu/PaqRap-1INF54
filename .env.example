# ---- BD de OPERACION: MySQL en la VM del equipo ----
# Copia este archivo a .env y completa los valores. .env NO se sube al repo.

# mysql = MySQL de la VM (esquema por Hibernate) | default = H2 en memoria
# Vuelta atrás rápida en la VM: PAQRAP_PERFIL_OPERACION=default y recrear el servicio "app".
PAQRAP_PERFIL_OPERACION=mysql

# En la VM: host.docker.internal (el MySQL está en la misma VM que Docker).
# Desde tu PC con túnel SSH abierto: host.docker.internal también (apunta a tu PC).
APP_DB_HOST=host.docker.internal
APP_DB_PORT=3306
APP_DB_NAME=paqrap_operacion
# Usuario de la APP (no root). root solo se usa desde Workbench para administrar.
APP_DB_USER=paqrap
APP_DB_PASSWORD=### Contraseña de usuario Paqraq
# true solo si el servidor MySQL tiene TLS habilitado
APP_DB_SSL=false

# ---- Legado: Postgres local (solo con: docker compose --profile with-postgres up db) ----
#DB_LOCAL_PASSWORD=<contraseña-local>
