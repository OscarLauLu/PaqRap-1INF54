# ---- Postgres LOCAL (servicio "db" de docker-compose) ----
DB_LOCAL_PASSWORD=<contraseña-local>

# rds = Postgres (esquema por Hibernate) | default = H2 en memoria
PAQRAP_PERFIL_OPERACION=rds

# ---- Opcional: apuntar "app" a otra BD (p. ej. RDS) en vez del Postgres local ----
#APP_DB_HOST=<endpoint>
#APP_DB_USER=<usuario>
#APP_DB_PASSWORD=<contraseña>
#APP_DB_SSLMODE=require
